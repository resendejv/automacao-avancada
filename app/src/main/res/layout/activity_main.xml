<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0d0d1a">

    <!-- Cabeçalho de informações do usuário e Benchmark -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1a1a2e"
        android:padding="6dp">

        <!-- Linha 1: Jogador e Seleção de Núcleos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/textUsuarioLogado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Jogador: -"
                android:textColor="#BBBBBB"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cores:"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnCores1"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="38dp"
                android:layout_height="35dp"
                android:text="1"
                android:textSize="11sp"
                android:padding="0dp"
                android:layout_marginEnd="2dp"/>
            <Button
                android:id="@+id/btnCores2"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="38dp"
                android:layout_height="35dp"
                android:text="2"
                android:textSize="11sp"
                android:padding="0dp"
                android:layout_marginEnd="2dp"/>
            <Button
                android:id="@+id/btnCoresAll"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="45dp"
                android:layout_height="35dp"
                android:text="All"
                android:textSize="11sp"
                android:padding="0dp"/>
        </LinearLayout>

        <!-- Linha 2: Benchmark de Alvos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Benchmark Alvos:"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnBench10"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="1"
                android:text="10"
                android:textSize="11sp"
                android:padding="0dp"
                android:layout_marginEnd="4dp"/>
            <Button
                android:id="@+id/btnBench50"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="1"
                android:text="50"
                android:textSize="11sp"
                android:padding="0dp"
                android:layout_marginEnd="4dp"/>
            <Button
                android:id="@+id/btnBench100"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="1"
                android:text="100"
                android:textSize="11sp"
                android:padding="0dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Canvas do jogo (ocupa todo o espaço restante) -->
    <br.ufla.autotarget.JogoView
        android:id="@+id/jogoView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Barra de botões inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:gravity="center"
        android:background="#1a1a2e">

        <Button
            android:id="@+id/btnAdicionarCanhao"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/btn_adicionar_canhao"
            android:textSize="12sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnRanking"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Ranking"
            android:textSize="12sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnIniciar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/btn_iniciar"
            android:textSize="12sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Sair"
            android:textSize="12sp"
            android:backgroundTint="#B71C1C"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>
