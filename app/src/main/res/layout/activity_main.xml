<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0d0d1a">

    <!-- Canvas do jogo (ocupa todo o espaço restante) -->
    <br.ufla.autotarget.JogoView
        android:id="@+id/jogoView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Barra de botões inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center"
        android:background="#1a1a2e">

        <Button
            android:id="@+id/btnAdicionarCanhao"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/btn_adicionar_canhao"
            android:textSize="14sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnIniciar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="@string/btn_iniciar"
            android:textSize="14sp"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>
